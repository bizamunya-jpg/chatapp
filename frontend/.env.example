# Server-only backend URL. The browser reaches the backend through /api/backend.
BACKEND_URL=http://localhost:8080

# TURN relay for calls that cannot connect directly. Copy these from the ExpressTURN dashboard.
# Calls fall back to STUN only when these are empty.
TURN_URLS=turn:free.expressturn.com:3478?transport=udp,turn:free.expressturn.com:3478?transport=tcp
TURN_USERNAME=
TURN_PASSWORD=

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# OAuth client credentials are configured in Google Cloud Console and GitHub.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
